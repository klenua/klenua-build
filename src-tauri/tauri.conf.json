{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "klenua build",
  "mainBinaryName": "klenua build",
  "version": "1.0.0",
  "identifier": "com.versionpilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "klenua build",
        "width": 1120,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 760,
        "maxWidth": 1120,
        "maxHeight": 760,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/klenua.png", "icons/klenua.icns", "icons/klenua.ico"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "bundleName": "klenua build"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NEE2NUU3RkJERTIzNTMKUldSVEk5Nzc1MlZLYWJxMnozd2dRWUhsVHFsanFmdnFML3JLODVWblFnVENpYllxaWtJUlNqZ2YK",
      "endpoints": [
        "https://github.com/klenua/klenua-build/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
