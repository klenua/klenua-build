{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "klenua",
  "mainBinaryName": "klenua",
  "version": "1.1.0",
  "identifier": "com.versionpilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "klenua",
        "width": 1120,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 760,
        "maxWidth": 1120,
        "maxHeight": 760,
        "resizable": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "bundleName": "klenua"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NEE2NUU3RkJERTIzNTMKUldSVEk5Nzc1MlZLYWJxMnozd2dRWUhsVHFsanFmdnFML3JLODVWblFnVENpYllxaWtJUlNqZ2YK",
      "endpoints": [
        "https://github.com/klenua/klenua-build/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
